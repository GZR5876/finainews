# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Email delivery (Resend)
RESEND_API_KEY=re_...
RESEND_FROM=ai-weekly@yourdomain.com
RESEND_TO=cfo@yourcompany.com

# Optional: Voyage embeddings for semantic dedup
VOYAGE_API_KEY=

# Gate 1 server
GATE1_HOST=127.0.0.1
GATE1_PORT=8765

# How many weeks back to check for duplicate coverage
HISTORY_WEEKS=6
