<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI in Focus -- {{ week }}</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #e8e8e8;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      color: #1c1c1c;
    }

    .wrapper {
      max-width: 620px;
      margin: 32px auto;
      background: #ffffff;
    }

    /* ── Header ── */
    .header {
      background: #0d0d0d;
      padding: 32px 36px 28px;
      border-bottom: 3px solid #333;
    }
    .header .label {
      font-size: 10px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #888;
      margin-bottom: 10px;
    }
    .header h1 {
      font-size: 20px;
      font-weight: 600;
      color: #f0f0f0;
      letter-spacing: 0.5px;
    }
    .header .meta {
      margin-top: 8px;
      font-size: 11px;
      color: #555;
    }

    /* ── Section ── */
    .section {
      padding: 0 36px;
      border-bottom: 1px solid #e0e0e0;
    }
    .section:last-of-type {
      border-bottom: none;
    }

    .section-header {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 20px 0 16px;
      border-bottom: 1px solid #ebebeb;
      margin-bottom: 4px;
    }
    .section-number {
      width: 22px;
      height: 22px;
      background: #0d0d0d;
      color: #e8e8e8;
      font-size: 10px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .section-title {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: #1c1c1c;
    }

    /* ── Story ── */
    .story {
      padding: 18px 0 14px;
      border-bottom: 1px solid #f0f0f0;
    }
    .story:last-child {
      border-bottom: none;
      padding-bottom: 20px;
    }
    .story h3 {
      font-size: 13px;
      font-weight: 700;
      color: #0d0d0d;
      margin-bottom: 7px;
      line-height: 1.4;
    }
    .story p {
      font-size: 12px;
      line-height: 1.7;
      color: #444;
    }
    .story p strong {
      color: #1c1c1c;
      font-weight: 600;
    }
    .story .source {
      margin-top: 8px;
      font-size: 10px;
      color: #999;
    }
    .story .source a {
      color: #777;
      text-decoration: none;
      word-break: break-all;
    }
    .story .source a:hover {
      color: #1c1c1c;
    }

    /* ── Footer ── */
    .footer {
      background: #0d0d0d;
      padding: 18px 36px;
      font-size: 10px;
      color: #555;
      letter-spacing: 0.3px;
    }
  </style>
</head>
<body>
<div class="wrapper">

  <div class="header">
    <div class="label">Weekly Intelligence Brief</div>
    <h1>AI in Focus &mdash; {{ week }}</h1>
    <div class="meta">CFO &amp; Finance Leadership &nbsp;/&nbsp; {{ issue_date }}</div>
  </div>

  {% for section in sections %}
  <div class="section">
    <div class="section-header">
      <div class="section-number">{{ loop.index }}</div>
      <div class="section-title">{{ section.label | replace(section.label[:3], '', 1) | trim }}</div>
    </div>
    {% for story in section.stories %}
    <div class="story">
      <h3>{{ story.headline }}</h3>
      <p>{{ story.body_html | striptags }}</p>
      <div class="source">Source: <a href="{{ story.source_url }}">{{ story.source_url }}</a></div>
    </div>
    {% endfor %}
  </div>
  {% endfor %}

  <div class="footer">
    Generated from public sources. Items selected and reviewed by the finance team.
  </div>

</div>
</body>
</html>
